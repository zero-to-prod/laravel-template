{
  "$schema": "https://getcomposer.org/schema.json",
  "require": {
    "php": "^8.5",
    "laravel/folio": "^1.1",
    "laravel/framework": "^13.17",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^3.0",
    "zero-to-prod/data-model": "^81.10",
    "zero-to-prod/data-model-factory": "^71.5",
    "zero-to-prod/data-model-helper": "^82.1",
    "zero-to-prod/db-model": "^0.1.0",
    "zero-to-prod/factory": "^0.1.1",
    "zero-to-prod/laravel-openapi": "^3.0",
    "zero-to-prod/package-helper": "^1.1.3",
    "zero-to-prod/schema-validator": "^0.3"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.5",
    "devizzent/cebe-php-openapi": "^1.1",
    "fakerphp/faker": "^1.23",
    "laravel/mcp": "^0.9.1",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.41",
    "league/openapi-psr7-validator": "^0.24.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "nyholm/psr7": "^1.8",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-rector": "^5.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.2.6",
    "rector/rector": "^2.5",
    "roave/security-advisories": "dev-latest",
    "symfony/psr-http-message-bridge": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "ide": [
      "Illuminate\\Foundation\\ComposerScripts::postUpdate",
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta",
      "@php artisan ide-helper:models --write-mixin"
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "test-fresh": "pest --tia --fresh",
    "test": "pest --tia",
    "coverage": [
      "@php artisan openapi:coverage --reset",
      "pest --tia --fresh --coverage --min=100",
      "@php artisan openapi:coverage"
    ],
    "analyse": "phpstan analyse",
    "format": "pint",
    "lint": "pint --test",
    "rector": "rector process",
    "rector-lint": "rector process --dry-run",
    "openapi-validate": "@php artisan openapi:validate",
    "openapi-coverage": "@php artisan openapi:coverage",
    "check": [
      "@lint",
      "@rector-lint",
      "@analyse",
      "@openapi-validate",
      "@coverage"
    ],
    "fix": [
      "@rector",
      "@format"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
